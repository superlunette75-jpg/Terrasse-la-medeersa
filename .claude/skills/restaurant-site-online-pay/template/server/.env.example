# Copy to server/.env and fill in. Never commit the real .env.
PORT=8787
PUBLIC_URL=http://localhost:8787   # the real https:// address once online

# Card payments: "cmi" (Moroccan company, contract through your bank),
# "stripe" (company registered where Stripe operates), or "none" (cash only)
PAYMENT_PROVIDER=none

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # webhook endpoint: PUBLIC_URL/api/stripe/webhook

# --- CMI (Morocco) --- given by the bank with the merchant kit
CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_FALLBACK_EMAIL=               # used when the customer leaves the e-mail empty

# --- Where new orders arrive (any or all) ---
TELEGRAM_BOT_TOKEN=               # free and instant: create a bot with @BotFather
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=               # Make / Zapier / n8n: forward to WhatsApp, e-mail, printer
